# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real keys.

# The live site's address, with no trailing slash. Used for the sitemap,
# canonical links, social previews, and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings > API (public values, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values (never prefix these with NEXT_PUBLIC_)
# Supabase service role key: used only to save notes after the integrity check.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API key from https://console.anthropic.com. Leave blank to run
# without AI features (notes still get the keyword integrity scan).
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5
