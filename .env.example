# Copy this file to .env.local and fill in the values from the team's Supabase project.
# Never commit .env.local or any file containing real keys.

# Public values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values (never prefix these with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AI_API_KEY=your-ai-provider-key
